{
  "name": "changelog-machine",
  "version": "1.1.0",
  "description": "Minimal, dependency-free conventional changelog and version generator",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "bin": {
    "changelog-machine": "./bin/cli.js"
  },
  "files": [
    "lib",
    "bin",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/*/*.test.js",
    "lint": "biome check src",
    "changelog": "npm run build && node bin/cli.js --full",
    "prepack": "npm run build"
  },
  "keywords": [
    "changelog",
    "conventional-commits",
    "git"
  ],
  "author": "Philipp Kief <philipp.kief@gmx.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PKief/changelog-machine.git"
  },
  "bugs": {
    "url": "https://github.com/PKief/changelog-machine/issues"
  },
  "funding": "https://github.com/sponsors/pkief",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}